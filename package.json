{
  "name": "trustech-ai-browser-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TrusTech — a premium futuristic AI browser agent operating as a Chrome/Firefox side panel with a living 3D robot companion.",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc --noEmit && vite build && vite build --config vite.content.config.ts && node tools/verify-content-build.mjs",
    "preview": "vite preview",
    "icons": "node build/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "metrics": "vitest run tests/metrics && node tools/generate-metrics-report.mjs",
    "performance": "npm run build && node tools/measure-bundles.mjs && vitest run tests/performance"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "keywords": [
    "browser-extension",
    "ai-agent",
    "threejs",
    "chrome-extension",
    "firefox-extension",
    "side-panel"
  ],
  "license": "MIT"
}
