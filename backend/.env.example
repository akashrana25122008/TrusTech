# Backend environment — API keys stay here (and in server env), NEVER in
# the extension bundle. .gitignore excludes this file; example ships only.

TRUSTECH_DEBUG=false
# Browser origins allowed CORS (no credentials; bearer-token gateway).
TRUSTECH_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
TRUSTECH_MODEL_URI=models/

# Bearer token protecting /api/* routes. EMPTY = open local demo gateway
# (default). Set a value for the internal judge/demo deployment; supply the
# same value to the extension via chrome.storage.local keys
# "trustech.gatewayUrl" / "trustech.gatewayToken".
TRUSTECH_GATEWAY_TOKEN=

# AI provider credentials (server-side only; each field is repr=False).
# Groq is the existing secondary tier. Gemini is the new primary; the chain
# order is AI_PRIMARY_PROVIDER first, then the rest in default order.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
# openrouter/free resolves to a currently-available free model (rotates);
# pin an explicit model like nvidia/nemotron-3-super-120b-a12b:free if needed.
OPENROUTER_MODEL=openrouter/free

# Chain ordering + timers. Per-provider timeout guards each request; the
# total budget must stay under the extension's 60s gateway timeout.
AI_PRIMARY_PROVIDER=gemini
AI_PROVIDER_TIMEOUT_S=25
AI_TOTAL_TIMEOUT_S=50